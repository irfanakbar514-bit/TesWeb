    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.6.0/jquery.min.js"></script>

    <script>
    /* 1. DATA & SETUP */
    const weddingDate = new Date("Aug 15, 2026 08:00:00").getTime();
    const urlParams = new URLSearchParams(window.location.search);
    document.getElementById('guestName').innerText = urlParams.get('to') || "Tamu Undangan";

    const btnOpen = document.getElementById('btnOpen');
    const loader = document.getElementById('loader');
    const cover = document.getElementById('cover');
    const mainContent = document.getElementById('main-content');
    const bgm = document.getElementById('bgm');
    const musicBtn = document.getElementById('musicBtn');
    const musicIcon = musicBtn.querySelector('i');

    let isPlaying = false;

    /* 2. KUNCI JAWABAN: MENGHILANGKAN LOADER */
    // Ini yang tadi lu lupa, makanya mentok hitam terus
    window.addEventListener('load', function() {
        setTimeout(() => {
            loader.style.opacity = '0';
            setTimeout(() => { 
                loader.style.display = 'none'; 
            }, 800);
        }, 2000); 
    });

    /* 3. LOGIKA MUSIK (Satu Fungsi buat Semua) */
    function toggleAudio(action) {
        if (action === 'play') {
            bgm.play().then(() => {
                isPlaying = true;
                musicIcon.classList.add('fa-spin');
            }).catch(e => console.log("Audio diblokir"));
        } else {
            bgm.pause();
            isPlaying = false;
            musicIcon.classList.remove('fa-spin');
        }
    }

    /* 4. EVENT BUKA UNDANGAN */
    btnOpen.addEventListener('click', function() {
        toggleAudio('play'); // Musik nyala
        cover.style.transform = 'translateY(-100%)';
        mainContent.classList.add('active');
        document.body.classList.remove('no-scroll');
        
        setTimeout(() => {
            if (typeof AOS !== 'undefined') AOS.init({ duration: 1200, once: true });
            window.scrollTo(0, 0);
        }, 600);
    });

    /* 5. EVENT TOMBOL MUSIK (Toggle) */
    musicBtn.addEventListener('click', function() {
        if (isPlaying) toggleAudio('pause');
        else toggleAudio('play');
    });

    /* 6. COUNTDOWN (Biar Angka Jalan) */
    setInterval(function() {
        const now = new Date().getTime();
        const dist = weddingDate - now;
        if (dist < 0) return;

        document.getElementById("days").innerText = Math.floor(dist / (1000 * 60 * 60 * 24));
        document.getElementById("hours").innerText = Math.floor((dist % (1000 * 60 * 60 * 24)) / (1000 * 60 * 60));
        document.getElementById("minutes").innerText = Math.floor((dist % (1000 * 60 * 60)) / (1000 * 60));
        document.getElementById("seconds").innerText = Math.floor((dist % (1000 * 60)) / 1000);
    }, 1000);

    /* 7. FITUR TAMBAHAN (Copy & RSVP) */
    function copyRek(id, btn) {
        const el = document.getElementById(id);
        navigator.clipboard.writeText(el.innerText);
        const oldText = btn.innerHTML;
        btn.innerHTML = '<i class="fas fa-check"></i> DISALIN';
        setTimeout(() => { btn.innerHTML = oldText; }, 2000);
    }

    $('#weddingRsvp').on('submit', function(e) {
        e.preventDefault();
        const text = `Halo Irfan & Via,%0A*Nama:* ${$('#rsvp_name').val()}%0A*Hadir:* ${$('#rsvp_status').val()}%0A*Pesan:* ${$('#rsvp_message').val()}`;
        window.open(`https://api.whatsapp.com/send?phone=6282278199948&text=${text}`, '_blank');
    });

    /* 8. BUTIRAN EMAS */
    (function() {
        const container = document.getElementById('particleContainer');
        for (let i = 0; i < 40; i++) {
            const p = document.createElement('div');
            p.className = 'particle';
            p.style.width = p.style.height = (Math.random() * 5 + 2) + 'px';
            p.style.left = Math.random() * 100 + 'vw';
            p.style.animationDuration = (Math.random() * 5 + 5) + 's';
            p.style.animationDelay = Math.random() * 5 + 's';
            container.appendChild(p);
        }
    })();
</script>
